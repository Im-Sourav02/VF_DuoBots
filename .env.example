# Copy to .env and fill in values. Never commit .env.
# Required variables are listed first. Leave optional Bot 2 vars empty to run Bot 1 only.

# ── Shared ──────────────────────────────────────────────────
API_ID=
API_HASH=
OWNER_ID=
WORKERS=5
PORT=5010

# ── Bot 1 (Sadie Sink) — filestore, shortener, credits ──────
BOT1_TOKEN=
BOT1_BOT_USERNAME=VeloraFileShareRoBot
BOT1_DB_URI=
BOT1_DB_NAME=VF_Bot1
BOT1_DB_CHANNEL=
BOT1_AUTO_DEL=300
BOT1_PROTECT=false
BOT1_DISABLE_BTN=false
# BOT1_DISPLAY_NAME=𝘚𝘢𝘥𝘪𝘦 𝘚𝘪𝘯𝘬

# ── Bot 2 (Wanda) — link protector, no credits ──────────────
BOT2_TOKEN=
BOT2_BOT_USERNAME=VFFileBot
BOT2_DB_URI=
BOT2_DB_NAME=VF_Bot2
BOT2_DB_CHANNEL=
BOT2_AUTO_DEL=300
BOT2_PROTECT=false
BOT2_DISABLE_BTN=true
# BOT2_DISPLAY_NAME=𝖶𝖺𝗇𝖽𝖺

# Use distinct BOT1_DB_NAME / BOT2_DB_NAME. Sharing a database would mix users,
# settings, and Sadie Sink credit balances with Wanda.

# ── Shortener (Bot 1 / Sadie Sink) ──────────────────────────
SHORT_URL=shortxlinks.com
SHORT_API=
SHORT_TUT=
# Optional wrapper: https://<domain>/?to=<base64 short link>
REDIRECTOR_DOMAIN=

# ── Credits (Sadie Sink only) ───────────────────────────────
# CREDITS_PER_BYPASS=2 and CREDITS_PER_ACCESS=1 are code constants.
VERIFY_TOKEN_TTL=3600
VERIFY_MIN_SECONDS=0

# ── UI destinations (buttons omitted if left empty) ─────────
PREMIUM_LINK=
OWNER_LINK=
SUPPORT_LINK=
PREMIUM_PRICE_TEXT=₹1.5/Day

# ── Optional photos (HTTPS URL or Telegram file_id) ─────────
# START_PIC=
# BOT1_START_PHOTO=
# BOT1_HELP_PHOTO=
# BOT1_CHANNELS_PHOTO=
# BOT1_PREMIUM_PHOTO=
# BOT1_VERIFIED_PHOTO=
# BOT1_FSUB_PHOTO=
# BOT1_SHORT_PIC=
# BOT2_START_PHOTO=
# BOT2_HELP_PHOTO=
# BOT2_CHANNELS_PHOTO=
# BOT2_PREMIUM_PHOTO=
# BOT2_LINK_PHOTO=
# BOT2_FSUB_PHOTO=
